# ===== Supabase (من Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة: على الخادم فقط (Vercel Environment Variables) ولا يوضع في الواجهة أبدًا
SUPABASE_SERVICE_ROLE_KEY=

# ===== جلسات الطالبات ورموز الدخول =====
# قيم عشوائية طويلة (32 حرفًا فأكثر). مثال للتوليد: openssl rand -hex 32
STUDENT_SESSION_SECRET=
STUDENT_CODE_PEPPER=

# ===== اختياري: اقتراح سيناريو الدرس بالذكاء الاصطناعي (Google Gemini) =====
# إذا تُرك فارغًا لا يظهر زر الاقتراح، وتعد المعلمة السيناريو يدويًا.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
